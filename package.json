{
  "name": "mobile-nodemap",
  "version": "0.1.0",
  "description": "Mobile-first node graph editor and evaluator for TypeScript/JavaScript",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js" },
    "./runtime": { "types": "./dist/runtime/index.d.ts", "import": "./dist/runtime/index.js" },
    "./editor": { "types": "./dist/editor/index.d.ts", "import": "./dist/editor/index.js" }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-bundle.mjs",
    "demo": "node scripts/build-demo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "happy-dom": "20.0.10"
  }
}

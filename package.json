{
  "name": "mobile-nodemap",
  "version": "0.1.0",
  "description": "Mobile-first node graph editor and evaluator for TypeScript/JavaScript",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./element": {
      "types": "./dist/element/register.d.ts",
      "import": "./dist/element/register.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/element/register.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-bundle.mjs",
    "prepare": "npm run build",
    "demo": "node scripts/build-demo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "elkjs": "^0.12.1",
    "esbuild": "0.28.2",
    "happy-dom": "20.0.10",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "elkjs": ">=0.9"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "elkjs": {
      "optional": true
    }
  },
  "keywords": [
    "node-editor",
    "node-graph",
    "visual-programming",
    "mobile",
    "touch",
    "react",
    "web-component",
    "auto-layout"
  ]
}
